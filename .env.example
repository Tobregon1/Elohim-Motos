# ==============================================================================
# ELOHIM MOTOS - CONFIGURACIÓN DE ENTORNO (.env.local)
# ==============================================================================
# Si dejás estas variables vacías, la aplicación funciona automáticamente en
# "Modo Demo Interactivo" con persistencia en navegador (localStorage) y
# catálogo precargado para pruebas inmediatas.

# 1. Supabase (Base de Datos y Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. Marketing y Seguimiento (Opcional - también configurable desde /admin)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# 3. Clave de acceso rápido para el Backoffice local (/admin)
NEXT_PUBLIC_ADMIN_PIN=2026

